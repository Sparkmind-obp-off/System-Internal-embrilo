{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "embrilo-os",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  // Non-secret configuration only. Secrets go in `.dev.vars` (local) or
  // `wrangler pages secret put` (production). Never commit secret values.
  "vars": {
    "APP_ENV": "production",
    "CONNECTOR_KEY_ID": "public-embrilo-v1",
    "MAX_REVISION_ROUNDS": "2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "embrilo-os-production",
      // Production D1 (an ID is not a credential; access requires an authorized API token).
      "database_id": "81b35d2f-d31a-4479-a758-c4af8bcc83da",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI (Prompt Studio). Free allocation: 10,000 Neurons/day; the app caps itself at
  // 8,000 estimated Neurons/day by default (Pengaturan). No paid model is used by default.
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "embrilo-os-private" }
  ]
}
