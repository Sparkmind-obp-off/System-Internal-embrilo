{
  "name": "embrilo-os",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev:sandbox": "wrangler pages dev dist --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply embrilo-os-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply embrilo-os-production --remote",
    "db:seed:local": "wrangler d1 execute embrilo-os-production --local --file=./seed/seed.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed:local",
    "operator:sql": "node scripts/create-operator.mjs",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "miniflare": "^3.20250718.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.17"
  }
}
